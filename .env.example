# ==============================================================================
# Roots Industrial PPE Compliance Detector - Environment Configuration Template
# ==============================================================================
# Duplicate this file as '.env' and enter your facility-specific credentials.
# NOTE: The '.env' file is strictly excluded from version control (.gitignore).

# --- CCTV NVR / IP Camera Network Settings ---
CCTV_NVR_IP=192.168.127.5
CCTV_NVR_PORT=554
CCTV_NVR_USER=admin
CCTV_NVR_PASS=dmin@123
CCTV_BRAND=hikvision

# --- Monitored Camera Channels ---
# Channel mapping on NVR:
# D3  = PC Spray Booth West Wall (Ch 3 / 302 sub-stream)
# D29 = Powder Coating Office Area (Ch 29 / 2902 sub-stream)
# D23 = Tool Room (Ch 23 / 2302 sub-stream)
DEFAULT_CAMERA_CHANNEL=3

# --- Web Application Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Inference Hardware Acceleration ---
# 'cuda' (NVIDIA GPU with PyTorch CUDA) or 'cpu'
INFERENCE_DEVICE=cuda
